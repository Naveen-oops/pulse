# Copy to .env and adjust — `npm run setup` does this for you.
#
# .env is gitignored AND excluded from agent context via .cursorignore.
# Never paste real secrets into any other file in this repo.

# --- Shared ------------------------------------------------------------------

# Guards presenter-only actions: create room/poll, open/close, hide, mark answered.
PULSE_PRESENTER_TOKEN=demo-presenter-token

# Origins allowed to call the APIs from a browser.
PULSE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- poll-service ------------------------------------------------------------

# Default is SQLite on disk, so the app runs with no database to start.
# `npm run setup` rewrites this to PostgreSQL when Docker is available:
#   postgresql://pulse:pulse@localhost:5432/pulse
PULSE_DATABASE_URL=sqlite+pysqlite:///./pulse.db

# PostgreSQL only — one schema per service. Ignored on SQLite.
# PULSE_DB_SCHEMA=polls

# Port for `npm run poll-service`.
POLL_SERVICE_PORT=8001

# --- qa-service --------------------------------------------------------------

QA_DATABASE_URL=sqlite+pysqlite:///./qa.db
# QA_DB_SCHEMA=qa
QA_SERVICE_PORT=8002

# --- CrewAI / LiteLLM (phase 3) ----------------------------------------------

# OPENAI_API_BASE=http://localhost:4000/v1
# OPENAI_API_KEY=sk-litellm-local
# PULSE_CREW_MODEL=gemini/gemini-2.0-flash
